<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<!-- Toàn hệ thống: mọi app dùng UIKit. SpringBoard mặc định bị tắt trong Tweak.x (plist key springboard = true để bật).
		     Muốn quay lại thử riêng Ghi chú, thay bằng:
		     <key>Executables</key><array><string>MobileNotes</string></array> -->
		<key>Bundles</key>
		<array>
			<string>com.apple.UIKit</string>
		</array>
	</dict>
</dict>
</plist>
